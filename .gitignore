node_modules/
dist/
# Test-coverage OUTPUT, wherever a runner drops it — and never a source tree
# that happens to carry the same name. Unqualified, this line matched
# packages/connector-core/src/coverage/ and kept the whole module every
# answer surface imports out of the repository: `git add -A` skipped it, a
# fresh clone could not resolve it, and every test stayed green because they
# all read the working tree. The negation has to name the DIRECTORY — git
# never descends into an excluded one, so re-including a file inside it does
# nothing. render-surface-registry.test.ts fails the build if a registered
# module goes untracked again.
coverage/
!packages/*/src/coverage/
*.log
.DS_Store
.env
.env.*
# Gate evidence: red/green logs, e2e captures and throwaway-hub artefacts. It
# is deliberately WORKING-TREE ONLY — a reviewer reads it beside the branch,
# never inside it, and a `git add -A` that swept it in once already cost a
# history rewrite.
.gate/
